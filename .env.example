PORT=3000
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/deadline_agent?appName=Cluster0
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: GEMINI_MODEL=gemini-3.6-flash
# Optional: GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash
# Optional: GEMINI_RPM=5          # raise if your quota is higher
